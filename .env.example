# Shopify App Configuration
SHOPIFY_API_KEY=replace_with_your_shopify_api_key
SHOPIFY_API_SECRET=replace_with_your_shopify_api_secret
SHOPIFY_APP_URL=https://your-app.vercel.app
SCOPES=read_orders,read_customers,read_products,read_analytics,read_inventory,read_locations,read_draft_orders,write_products,write_metaobjects,write_metaobject_definitions

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host.example.com/db?sslmode=require

# Daily Email Brief (Resend)
RESEND_API_KEY=replace_with_your_resend_api_key
EMAIL_FROM=Naruto AI <onboarding@resend.dev>

# Cron protection
CRON_SECRET=replace_with_a_long_random_secret

# Optional: Custom shop domain
# SHOP_CUSTOM_DOMAIN=
